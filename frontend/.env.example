# Template only — copy to frontend/.env for local overrides. Never commit real values.
#
# Leave this UNSET for local development: requests stay relative and CRA's
# "proxy" (package.json) forwards them to the backend on localhost:5050.
#
# Set it for production builds so the deployed bundle knows where the API lives.
# CRA inlines REACT_APP_* at BUILD time, so it must be present when you run
# `npm run build` — setting it on the host at runtime has no effect.
#
# REACT_APP_API_URL=https://family-grocery-app.onrender.com

# AI menu suggestions. Off unless this is exactly "true".
# While off, the app never calls Anthropic and needs no API key.
# REACT_APP_ENABLE_AI_SUGGESTIONS=true
